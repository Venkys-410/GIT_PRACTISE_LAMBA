def outer():
    for i in range(10):
        print("produce",i)
        yield i

print("###########--List Comprehension--#############")
print(
    any([ x>3 for x in outer()])  #here any did not stop even though at 4 a TRUE is found beacause of list comprehension
)

print("###########--Generator Comprehension--#############")

print(any( x>3 for x in outer()))  #here any stopped once the True value is found

